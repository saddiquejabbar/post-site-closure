# Telegram
TELEGRAM_BOT_TOKEN=replace-me
# Generate a long random value and pass the same value when setting the Telegram webhook.
TELEGRAM_WEBHOOK_SECRET=replace-with-random-secret
APPROVER_TELEGRAM_IDS=123456789
ALLOWED_TELEGRAM_CHAT_IDS=-1001234567890

# Local Google Drive for Desktop path to the shared macro-enabled workbook.
WORKBOOK_PATH=/Users/yourname/Library/CloudStorage/GoogleDrive-your-domain/Shared drives/Ops/Inventory2.xlsm
WORKBOOK_MAPPING_PATH=examples/workbook_mapping.example.json
CATALOG_PATH=examples/catalog.example.json

# Keep backups outside the Google Drive sync folder.
BACKUP_DIR=/Users/yourname/inventory-backups
STATE_DB_PATH=data/inventory.sqlite3
TIMEZONE=Asia/Singapore
LOCK_TIMEOUT_SECONDS=5

# Start false. Enable only after testing a sanitized workbook copy and verifying the mapping.
ENABLE_WRITES=false

# Optional read-only status endpoint token.
ADMIN_API_TOKEN=replace-with-another-random-secret
