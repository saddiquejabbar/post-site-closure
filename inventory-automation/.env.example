# Safe default: validation and approvals work; production workbook replacement does not.
WRITE_ENABLED=false

TELEGRAM_BOT_TOKEN=replace-me
TELEGRAM_WEBHOOK_SECRET=replace-with-a-long-random-secret
ALLOWED_CHAT_IDS=-1001234567890
ALLOWED_USER_IDS=111111111,222222222
APPROVER_USER_IDS=111111111

# Local Google Drive for desktop path. Never commit the real path.
INVENTORY_WORKBOOK_PATH=/absolute/path/to/Inventory2.xlsm
SKU_ALIASES_PATH=./config/sku_aliases.example.json

STATE_DB_PATH=./state/inventory.sqlite3
LOCK_FILE_PATH=./state/inventory-writer.lock
STAGING_DIR=./state/staging
BACKUP_DIR=./state/backups

TIMEZONE=Asia/Singapore
CALLBACK_TTL_MINUTES=30
MAX_ABS_QUANTITY=1000
MAX_ITEMS_PER_REQUEST=50
SOURCE_STABILITY_SECONDS=1.0
POST_WRITE_STABILITY_SECONDS=0.5
REQUIRE_VBA_PROJECT=true

LOG_SHEET_NAME=Log
HEADER_ROW=3
DATA_START_ROW=4
DATA_END_ROW=9956
SKU_START_COLUMN=J
SKU_END_COLUMN=HF
STATUS_COLUMN=HG
