# Optional standalone-runner token. Leave blank when OpenClaw owns Telegram,
# which is the recommended deployment.
TELEGRAM_BOT_TOKEN=

# Group chat ID used for automatic per-site closure prompts.
# Leave blank if you only want to trigger /close_sites manually.
TELEGRAM_GROUP_CHAT_ID=

# Fallback send time used only when a DMR entry has no "- 10:30am" style
# appointment time attached to it. Sites with a parsed time send at that time.
POST_SITE_TIME=18:00

# Used only after a Telegram send failure. Normal scheduling does not poll: it
# sleeps until the next site time and wakes immediately when a DMR is ingested.
POST_SITE_RETRY_SECONDS=60

TIMEZONE=Asia/Singapore

# DMR staff mapping stays LOCAL. Do not commit real employee details to a public repo.
STAFF_1_NAME=Staff 1
STAFF_1_MENTION=@staff1
STAFF_2_NAME=Staff 2
STAFF_2_MENTION=@staff2
STAFF_3_NAME=Staff 3
STAFF_3_MENTION=@staff3
STAFF_4_NAME=Staff 4
STAFF_4_MENTION=@staff4
STAFF_5_NAME=Staff 5
STAFF_5_MENTION=@staff5
STAFF_6_NAME=Staff 6
STAFF_6_MENTION=@staff6

# Optional: final site payload is POSTed here. Point this to an n8n webhook later.
CRM_WEBHOOK_URL=

# Local SQLite database
POSTSITE_DB=data/postsite.db
